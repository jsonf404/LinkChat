MYSQL_DATABASE=linkchat
MYSQL_USER=linkchat
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-mail@example.com
SMTP_PASSWORD=your-mail-provider-app-password
GATE_HTTP_PORT=8080
CHAT_TCP_PORT=8090
CHAT_ADVERTISE_HOST=127.0.0.1
AI_ENABLED=true
AI_UID=900000001
AI_HOST=host.docker.internal
AI_PORT=8080
AI_PATH=/v1/chat/completions
AI_MODEL=qwen
AI_NAME=QwenBot
AI_NICK=Qwen AI
AI_ICON=:/res/head_1.jpg
AI_SYSTEM_PROMPT=你是一个友好的中文聊天助手。
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7
AI_HISTORY_TURNS=6
AI_TIMEOUT_MS=30000
